<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="WoodLog_Acacia"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <TerrainDef>
              <defName>SoilShip_Acacia</defName>
              <label>artificial soil substrate</label>
              <description>Synthetic soil laced with catalysts and micro-organisms, theoretically self-sustaining even aboard a starship.</description>
              <layerable>true</layerable>
              <texturePath>Terrain/Surfaces/Light_Tech_Soil</texturePath>
              <edgeType>Hard</edgeType>
              <renderPrecedence>340</renderPrecedence>
              <pathCost>2</pathCost>
              <statBases>
                <Beauty>-1</Beauty>
                <Cleanliness>-1</Cleanliness>
              </statBases>
              <tags>
                <li>Ship</li>
              </tags>
              <affordances>
                <li>Light</li>
                <li>Medium</li>
                <li>Heavy</li>
                <li>GrowSoil</li>
                <li>Diggable</li>
              </affordances>
              <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
              <generatedFilth>Filth_Dirt</generatedFilth>
              <fertility>1.0</fertility>
              <takeFootprints>True</takeFootprints>
              <tools>
                <li>
                  <label>dirt</label>
                  <capacities>
                    <li>KickMaterialInEyes</li>
                  </capacities>
                  <hediff>DirtInEyes</hediff>
                  <cooldownTime>1.5</cooldownTime>
                </li>
              </tools>
              <filthAcceptanceMask>
                <li>Unnatural</li>
              </filthAcceptanceMask>
              <researchPrerequisites>
                <li>ShipBasics</li>
              </researchPrerequisites>
              <designationCategory>Floors</designationCategory>
              <designatorDropdown>EW_Designator_SoilShip</designatorDropdown>
              <costList>
                <WoodLog_Acacia>1</WoodLog_Acacia>
              </costList>
              <color>(219, 184, 144)</color>
            </TerrainDef>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
