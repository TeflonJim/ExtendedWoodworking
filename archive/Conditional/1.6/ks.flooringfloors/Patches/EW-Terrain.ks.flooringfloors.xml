<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="WoodLog_Acacia"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <TerrainDef ParentName="ksWoodParquetBase">
              <defName>KS_WoodDiamond_Acacia</defName>
              <label>diamond parquet</label>
              <description>Parquet floor laid in an exquisite diamond pattern, for expressing economic status. Takes a long time to lay but is very beautiful.</description>
              <texturePath>Terrain/Surfaces/Wood/ksWoodDiamond</texturePath>
              <uiIconPath>Icons/Wood/ksWoodDiamond</uiIconPath>
              <statBases>
                <WorkToBuild>1800</WorkToBuild>
                <Beauty>3</Beauty>
              </statBases>
              <designatorDropdown>EW_Designator_KS_WoodDiamond</designatorDropdown>
              <costList>
                <WoodLog_Acacia>15</WoodLog_Acacia>
              </costList>
              <color>(219, 184, 144)</color>
            </TerrainDef>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
