    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <TerrainDef ParentName="ABooks_FloorBase">
              <defName>ABooks_OldWoodenFloor_Acacia</defName>
              <label>old acacia wood floor</label>
              <description>An old ruined acacia floor. Broken due to lack of maintenance.</description>
              <texturePath>Terrain/Surfaces/ABooks_RuinedFloor</texturePath>
              <edgeType>Hard</edgeType>
              <renderPrecedence>71</renderPrecedence>
              <statBases>
                <Beauty>-1</Beauty>
                <WorkToBuild>100</WorkToBuild>
              </statBases>
              <designatorDropdown>EW_Designator_ABooks_OldWoodenFloor</designatorDropdown>
              <costList>
                <WoodLog_Acacia>1</WoodLog_Acacia>
              </costList>
              <color>(219, 184, 144)</color>
            </TerrainDef>
          </value>
