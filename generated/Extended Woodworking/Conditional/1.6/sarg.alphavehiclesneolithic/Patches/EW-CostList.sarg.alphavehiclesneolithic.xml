<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint"]/costList/WoodLog</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint"]/costList/WoodLog</xpath>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint" and (stuffCategories)]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint"]/stuffCategories</xpath>
            <value>
              <li>Woody</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint"]</xpath>
            <value>
              <stuffCategories>
                <li>Woody</li>
              </stuffCategories>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint" and not(costStuffCount)]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint" and not(costStuffCount)]</xpath>
            <value>
              <costStuffCount>30</costStuffCount>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint"]/constructEffect</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThingDef[defName="AV_Balloon_Blueprint"]/constructEffect</xpath>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
