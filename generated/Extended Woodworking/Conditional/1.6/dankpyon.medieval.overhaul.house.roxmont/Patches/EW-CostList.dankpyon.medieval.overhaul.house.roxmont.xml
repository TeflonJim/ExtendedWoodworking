            <value>
              <stuffCategories>
                <li>Woody</li>
              </stuffCategories>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont" and not(costStuffCount)]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont" and not(costStuffCount)]</xpath>
            <value>
              <costStuffCount>55</costStuffCount>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont"]/constructEffect</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont"]/constructEffect</xpath>
