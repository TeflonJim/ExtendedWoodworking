<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox"]/costList/WoodLog</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox"]/costList/WoodLog</xpath>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox" and (stuffCategories)]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox"]/stuffCategories</xpath>
            <value>
              <li>Woody</li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox"]</xpath>
            <value>
              <stuffCategories>
                <li>Woody</li>
              </stuffCategories>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox" and not(costStuffCount)]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox" and not(costStuffCount)]</xpath>
            <value>
              <costStuffCount>10</costStuffCount>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox"]/constructEffect</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThingDef[defName="DankPyon_HideoutRusticBarrelStackRox"]/constructEffect</xpath>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont"]/costList/WoodLog</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont"]/costList/WoodLog</xpath>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont" and (stuffCategories)]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DankPyon_MeleeWeapon_PikeRoxmont"]/stuffCategories</xpath>
            <value>
              <li>Woody</li>
            </value>
          </match>
